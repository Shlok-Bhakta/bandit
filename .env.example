# Copy to .env (git-ignored) or ~/.config/neural-playground/build.env. ios-build.sh (make app,
# Gala) reads both; in Xcode, set the same names in Config/Local.xcconfig instead.

# The Mac serving dongle firmware releases over Tailscale, for the app's update button.
DONGLE_RELEASES_HOST=my-mac.example.ts.net
