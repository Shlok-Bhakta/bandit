# Copy to config.mk (git-ignored) if your Rust ESP toolchain isn't in espup's default places.
# RUSTUP_HOME = /path/to/esp/rustup
# CARGO_HOME = /path/to/esp/cargo
# EXPORT_ESP = /path/to/esp/export-esp.sh
# HOST_TARGET = /path/to/host-target   # where ../dongle-pack builds
# PORT = /dev/cu.usbmodem1101           # the dongle's serial port
# REMOTE = kiwi                         # the dongle is plugged into this ssh host instead (make remote-setup)
# REMOTE_PORT = /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_<MAC>-if00   # which board there, with two plugged in
# BUILD_HOST = crabcake                 # build on this ssh host instead (README: "Building on another machine")
