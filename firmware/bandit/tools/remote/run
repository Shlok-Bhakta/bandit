#!/bin/sh
# bandit/run TOOL ARGS…: a bandit tool on the dongle plugged into this machine, for `make`
# on the Mac with REMOTE set (README: "The dongle on another machine"). TOOL is a tools/*.py
# script (it gets the port first), or `flash` (the images `make flash` copied into flash/).
cd "$(dirname "$0")" || exit 1
port=${BANDIT_PORT:-$(ls /dev/serial/by-id/usb-Espressif* 2>/dev/null | head -n 1)}
if [ -z "$port" ]; then
    echo "no dongle plugged into $(hostname) (nothing at /dev/serial/by-id/usb-Espressif*)" >&2
    exit 1
fi
if [ ! -r "$port" ] || [ ! -w "$port" ]; then
    echo "can't open $port: run once on $(hostname): sudo sh ~/bandit/setup-access.sh" >&2
    exit 1
fi
tool=$1
shift
case $tool in
    flash)
        exec bin/espflash flash --port "$port" --chip esp32s3 --flash-size 8mb --flash-freq 80mhz \
            --bootloader flash/bootloader.bin --partition-table flash/partitions.csv \
            --target-app-partition ota_0 --erase-parts otadata flash/bandit ;;
    *)
        exec python3 -I "tools/$tool" "$port" "$@" ;;
esac
