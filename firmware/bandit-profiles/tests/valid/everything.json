{
  "format": "bandit-profiles",
  "version": 1,
  "name": "Every action",
  "menu": {
    "m": "profile:music",
    "n": "profile:next",
    "b": "profile:previous",
    "h": "host:mac",
    "p": "host:previous",
    "l": "host:next",
    "k": "key:cmd+k",
    "5": "type:hello",
    "w": "write"
  },
  "start": {
    "phone": "music",
    "computer": "desk",
    "tv": "music"
  },
  "profiles": [
    {
      "id": "music",
      "name": "Music",
      "buzz": 2,
      "description": "the app may add fields",
      "symbol": "music.note",
      "gestures": {
        "index.tap": "media:playPause",
        "index.doubleTap": "media:next",
        "index.tripleTap": "media:previous",
        "middle.tap": "phoneMute",
        "middle.doubleTap": "media:mute",
        "middle.tripleTap": "none",
        "swipe.up": { "phone": "call:answer" },
        "swipe.down": { "phone": "call:end" },
        "middle.hold": {
          "phone": "media:voice",
          "computer": "hold:alt+space",
          "mac": "hold:cmd+shift+space",
          "default": "none"
        },
        "index.hold": "menu",
        "dial.cw": "media:volumeUp",
        "dial.ccw": "media:volumeDown"
      }
    },
    {
      "id": "desk",
      "name": "Desk",
      "hosts": [
        "computer"
      ],
      "typing": true,
      "pointer": true,
      "buzz": 4,
      "gestures": {
        "swipe.up": "mouse:scrollUp:10",
        "swipe.down": "mouse:scrollDown",
        "swipe.left": "mouse:rightClick",
        "swipe.right": "mouse:middleClick",
        "index.doubleTap": "mouse:click",
        "middle.doubleTap": "key:ctrl+alt+delete",
        "middle.tap": "key:cmd++",
        "index.tap": "key:f12",
        "index.hold": "profile:next",
        "middle.hold": "type:Hi there!",
        "index.tripleTap": "write:15"
      },
      "apps": [
        "com.google.Chrome",
        "company.thebrowser.Browser",
        "org.mozilla.firefox"
      ]
    }
  ]
}
